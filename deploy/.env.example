# Copier en deploy/.env (jamais commité).
COP_PUBLIC_BASE=https://opencop.org
# Secret de signature des cookies : python -c "import secrets;print(secrets.token_urlsafe(32))"
COP_SECRET=
# Hôtes publics admis par le MCP (protection anti-rebinding) : l'ancienne adresse reste servie (connecteurs existants)
MCP_ALLOWED_HOSTS=opencop.org,www.opencop.org,cop31.akimx.fr
# Courrier entrant : reste sur l'ancien domaine (abonnements aux lettres, MX, certificat) ; sinon déduit de COP_PUBLIC_BASE
COP_MAIL_DOMAIN=cop31.akimx.fr
# Embeddings (vide = recherche lexicale seule). Les documents restreints ne sont pas envoyés.
OPENAI_API_KEY=
COP_EMBED_PROVIDER=openai
# Bot Telegram (créé avec @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
COP_TELEGRAM_RESTRICTED_SNIPPETS=0
COP_TZ=Europe/Istanbul
COP_DIGEST_HOURS=7,19
COP_CONTACT_EMAIL=
COP_HOST_DELAY=1.0
